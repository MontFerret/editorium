<idea-plugin url="https://ferretlang.org">
    <id>org.ferretlang.jetbrains</id>
    <name>Ferret</name>
    <vendor url="https://ferretlang.org">Ferret</vendor>
    <description><![CDATA[
        Edit, run, and debug Ferret Query Language (.fql) files in IntelliJ IDEA and GoLand.
        The bundled Ferret daemon provides language assistance, formatting, and execution
        against local and application-hosted runtimes.
        <p><a href="https://ferretlang.org">Ferret project</a> ·
        <a href="https://github.com/MontFerret/editorium">Source</a> ·
        <a href="https://github.com/MontFerret/editorium/issues">Report an issue</a> ·
        <a href="https://github.com/MontFerret/editorium/blob/main/LICENSE">Apache License 2.0</a></p>
    ]]></description>
    <change-notes><![CDATA[
        Initial release with file recognition, language-server integration, runtime selection,
        native Run configurations, breakpoints, stepping, variable inspection, and watches.
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>
    <depends>com.intellij.modules.lsp</depends>
    <depends>com.intellij.modules.xdebugger</depends>

    <extensions defaultExtensionNs="com.intellij">
        <projectConfigurable parentId="language" id="org.ferretlang.jetbrains.runtime" displayName="Ferret"
            instance="org.ferretlang.jetbrains.runtime.FerretRuntimeConfigurable" />
        <programRunner implementation="org.ferretlang.jetbrains.debugger.FerretDebugRunner" />
        <xdebugger.breakpointType implementation="org.ferretlang.jetbrains.debugger.FerretBreakpointType" />
        <fileType
            name="Ferret"
            implementationClass="org.ferretlang.jetbrains.lang.FerretLanguageFileType"
            fieldName="INSTANCE"
            language="Ferret"
            extensions="fql" />
        <configurationType
            implementation="org.ferretlang.jetbrains.run.FerretRunConfigurationType" />
        <runConfigurationProducer
            implementation="org.ferretlang.jetbrains.run.FerretRunConfigurationProducer" />
        <platform.lsp.integrationProvider
            implementation="org.ferretlang.jetbrains.lsp.FerretLspIntegrationProvider" />
    </extensions>
</idea-plugin>
