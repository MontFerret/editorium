{
  "name": "@montferret/editorium",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "extensions/*"
  ],
  "scripts": {
    "postinstall": "npm run proto:sync",
    "proto:sync": "node ./scripts/proto.mjs",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test:distribution && npm run test --workspaces --if-present",
    "test:distribution": "node --test ./scripts/*.test.mjs ./extensions/vscode/scripts/*.test.mjs",
    "package": "npm run package --workspaces --if-present",
    "package:check": "npm run package:check --workspaces --if-present",
    "vscode:prepare": "npm run distribution:prepare --workspace fql --",
    "vscode:package": "npm run distribution:package --workspace fql --",
    "vscode:install": "npm run distribution:install --workspace fql --"
  },
  "devDependencies": {
    "semver": "7.8.5",
    "tar-stream": "2.2.0",
    "yauzl": "3.4.0",
    "yazl": "2.5.1"
  }
}
